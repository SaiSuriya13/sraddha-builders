# Neon PostgreSQL connection string
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Resend API key for email notifications (https://resend.com/api-keys)
RESEND_API_KEY=

# Email address that receives new customer enquiry notifications
LEAD_NOTIFICATION_EMAIL=sraddhabuilders@gmail.com

# Sender address used by Resend (must be a domain verified in Resend)
EMAIL_FROM=onboarding@resend.dev

# WhatsApp number in international format WITHOUT "+" or spaces
# Example: 919845198438
# The WhatsApp button is hidden when this value is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Admin area (server-only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Required to enable /admin. Login is disabled with a clear 503 when unset.
# Use a long, unique password. Never commit the real value.
ADMIN_PASSWORD=

# Recommended. A long random string used to sign the admin session cookie.
# If omitted, ADMIN_PASSWORD is used as the signing key.
ADMIN_SESSION_SECRET=